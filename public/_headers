# Security headers for Cloudflare Pages.
#
# IMPORTANT: these only take effect when the site is hosted on Cloudflare Pages.
# GitHub Pages (where the site lives today) ignores this file. If you move to
# Cloudflare Pages (also free), they switch on automatically with no code changes.
#
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Stop the site being framed by other origins (clickjacking protection)
  X-Frame-Options: DENY
  # Do not let browsers guess a different content type
  X-Content-Type-Options: nosniff
  # Send only the origin, not the full path, when navigating to other sites
  Referrer-Policy: strict-origin-when-cross-origin
  # This site needs none of these device APIs
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # Force HTTPS for two years, including subdomains
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Fonts are self-hosted, so no outside hosts are allowed except the form services
  # that lib/site.ts can be pointed at. 'unsafe-inline' is needed by Next.js's static
  # hydration payload, because a static site has no server to issue per-request nonces.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://formspree.io https://api.web3forms.com; form-action 'self' mailto:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Build assets have fingerprinted file names, so they can be cached for a year
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
